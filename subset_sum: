class Solution {
  public:
    vector<int> subsetSums(vector<int>& nums) {
        int n=nums.size();
        vector<int> sums;

        for(int mask=0;mask<(1<<n);mask++){
            int sum=0;

            for(int i=0;i<n;i++){

                if(mask & (1<<i)){
                    sum+=nums[i];
                }
            }
            sums.push_back(sum);


        }
        sort(sums.begin(),sums.end());
        return sums;
    }
};
